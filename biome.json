{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!.next", "!dist", "!build"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "jsxQuoteStyle": "single",
      "quoteStyle": "single",
      "quoteProperties": "asNeeded",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "react": "recommended",
      "drizzle": "all",
      "playwright": "all",
      "tailwind": "all",
      "test": "recommended"
    },
    "rules": {
      "a11y": {
        "noNoninteractiveElementInteractions": "on"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "on",
        "noExcessiveNestedTestSuites": "on",
        "noForEach": "on",
        "noImplicitCoercions": {
          "level": "on",
          "options": {
            "allowDoubleNegation": true
          }
        },
        "noRedundantDefaultExport": "on",
        "noUselessCatchBinding": "on",
        "noUselessUndefined": "on",
        "noVoid": "on",
        "useArrayFind": "on",
        "useMaxParams": "on"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
