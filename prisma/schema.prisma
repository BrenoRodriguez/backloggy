generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ====== AUTH ======

model User {
  id              String         @id
  name            String
  email           String         @unique
  emailVerified   Boolean        @default(false)
  image           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  displayUsername String?        @unique
  username        String?        @unique
  accounts        Account[]
  sessions        Session[]
  reviews         Review[]
  backlogEntries  BacklogEntry[]
  settings        Settings?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model ApiToken {
  provider  String   @id
  token     String
  expiresAt DateTime @map("expires_at")

  @@map("api_token")
}

// ====== IGDB MODELS ======

model Franchise {
  igdbId Int @id @map("igdb_id")

  name      String
  slug      String?
  updatedAt DateTime        @map("updated_at")
  games     FranchiseGame[]

  @@map("franchise")
}

model Collection {
  igdbId Int @id @map("igdb_id")

  name      String
  slug      String?
  updatedAt DateTime         @map("updated_at")
  games     CollectionGame[]

  @@map("collection")
}

model Company {
  igdbId   Int  @id @map("igdb_id")
  parentId Int? @map("parent_id")

  name         String
  slug         String?
  country      String?
  description  String?
  foundingDate DateTime?     @map("founding_date")
  url          String?
  status       CompanyType?
  logo         String?
  updatedAt    DateTime      @map("updated_at")
  parent       Company?      @relation("parent_company", fields: [parentId], references: [igdbId])
  children     Company[]     @relation("parent_company")
  games        CompanyGame[]

  @@map("company")
}

enum CompanyType {
  MAIN_COMPANY
  DIVISION
  SUBSIDIARY
  HOLDING_COMPANY
  SOLO_DEV
}

model Platform {
  igdbId          Int            @id @map("igdb_id")
  slug            String?
  abbreviation    String?
  alternativeName String?        @map("alternative_name")
  name            String
  logo            String?
  family          String?
  updatedAt       DateTime       @map("updated_at")
  games           PlatformGame[]
  backlogEntries  BacklogEntry[]

  @@map("platform")
}

model Game {
  igdbId Int @id @map("igdb_id")

  name            String
  url             String
  cover           String?
  banner          String?
  storyline       String?
  summary         String?
  slug            String            @unique
  themes          String[]
  genres          String[]
  releaseDate     DateTime?         @map("release_date")
  engine          String?
  status          GameStatus?
  type            GameType?
  updatedAt       DateTime          @map("updated_at")
  reviews         Review[]
  franchises      FranchiseGame[]
  companies       CompanyGame[]
  platforms       PlatformGame[]
  collectionGames CollectionGame[]
  languageSupport LanguageSupport[]
  relatedGames    GameGame[]        @relation("game_relations")
  baseGames       GameGame[]        @relation("base_game")
  backlogEntries  BacklogEntry[]

  @@map("game")
}

enum GameType {
  MAIN_GAME
  DLC
  EXPANSION
  BUNDLE
  STANDALONE_EXPANSION
  MOD
  EPISODE
  SEASON
  REMAKE
  REMASTER
  EXPANDED_GAME
  PORT
  FORK
  PACK_ADDON
  UPDATE
}

enum GameStatus {
  RELEASED
  ALPHA
  BETA
  EARLY_ACCESS
  OFFLINE
  CANCELLED
  RUMORED
  DELISTED
  UNKNOWN
}

model LanguageSupport {
  gameId   Int    @map("game_id")
  language String
  game     Game   @relation(fields: [gameId], references: [igdbId], onDelete: Cascade)

  @@id([gameId, language])
  @@map("language_support")
}

// ====== JUNCTION TABLES ======

model GameGame {
  id            Int              @id @default(autoincrement())
  baseGameId    Int              @map("base_game_id")
  relatedGameId Int              @map("related_game_id")
  relationType  GameRelationType @map("relation_type")

  baseGame    Game @relation("base_game", fields: [baseGameId], references: [igdbId], onDelete: Cascade)
  relatedGame Game @relation("game_relations", fields: [relatedGameId], references: [igdbId], onDelete: Cascade)

  @@unique([baseGameId, relatedGameId, relationType])
  @@index([baseGameId])
  @@index([relatedGameId])
  @@map("game_game")
}

enum GameRelationType {
  REMAKE
  REMASTER
  PORT
  DLC
  EXPANSION
  BUNDLE
  SIMILAR
  EXPANDED_VERSION
}

model FranchiseGame {
  id          Int @id @default(autoincrement())
  franchiseId Int @map("franchise_id")
  gameId      Int @map("game_id")

  franchise Franchise @relation(fields: [franchiseId], references: [igdbId], onDelete: Cascade)
  game      Game      @relation(fields: [gameId], references: [igdbId], onDelete: Cascade)

  @@unique([franchiseId, gameId])
  @@index([gameId])
  @@map("franchise_game")
}

model CompanyGame {
  id        Int                     @id @default(autoincrement())
  companyId Int                     @map("company_id")
  gameId    Int                     @map("game_id")
  type      CompanyGameRelationType

  company Company @relation(fields: [companyId], references: [igdbId], onDelete: Cascade)
  game    Game    @relation(fields: [gameId], references: [igdbId], onDelete: Cascade)

  @@unique([companyId, gameId, type])
  @@index([gameId])
  @@map("company_game")
}

enum CompanyGameRelationType {
  DEVELOPED
  PUBLISHED
}

model PlatformGame {
  id         Int @id @default(autoincrement())
  gameId     Int @map("game_id")
  platformId Int @map("platform_id")

  platform Platform @relation(fields: [platformId], references: [igdbId], onDelete: Cascade)
  game     Game     @relation(fields: [gameId], references: [igdbId], onDelete: Cascade)

  @@unique([gameId, platformId])
  @@index([platformId])
  @@map("platform_game")
}

model CollectionGame {
  id           Int        @id @default(autoincrement())
  collectionId Int        @map("collection_id")
  gameId       Int        @map("game_id")
  collection   Collection @relation(fields: [collectionId], references: [igdbId], onDelete: Cascade)
  game         Game       @relation(fields: [gameId], references: [igdbId], onDelete: Cascade)

  @@unique([collectionId, gameId])
  @@index([gameId])
  @@map("collection_game")
}

model BacklogEntryGenre {
  backlogEntryId Int
  genreId        Int

  backlogEntry BacklogEntry @relation(fields: [backlogEntryId], references: [id], onDelete: Cascade)
  genre        Genre        @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([backlogEntryId, genreId])
  @@index([genreId])
}

// ====== USER CONTENT ======

// === SETTINGS ===

model Settings {
  userId      String        @id
  genres      Genre[]
  tagSettings TagSettings[]
  priorities  Priority[]
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Genre {
  id     Int    @id @default(autoincrement())
  userId String @map("user_id")
  name   String

  settings       Settings            @relation(fields: [userId], references: [userId], onDelete: Cascade)
  backlogEntries BacklogEntryGenre[]

  @@unique([userId, name])
  @@map("genre")
}

model Priority {
  id             Int            @id @default(autoincrement())
  userId         String         @map("user_id")
  label          String
  level          PriorityLevel
  backlogEntries BacklogEntry[]
  // wishlistEntries WishlistEntry[]
  settings       Settings       @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, level])
}

enum PriorityLevel {
  ONE
  TWO
  THREE
  FOUR
  FIVE
  SIX
  SEVEN
  EIGHT
  NINE
  TEN
}

model TagSettings {
  id     Int    @id @default(autoincrement())
  userId String @map("user_id") // references Settings.userId

  active  Boolean  @default(false)
  type    TagType  @default(TEXT)
  label   String
  slot    TagSlot
  presets String[] @default([])

  settings Settings @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, slot])
  @@map("tag_settings")
}

enum TagType {
  NUMBER
  TEXT
  LIST
  DATE
}

enum TagSlot {
  FIRST
  SECOND
  THIRD
  FOURTH
  FIFTH
}

// === BACKLOG ===

model BacklogEntry {
  id               Int                     @id @default(autoincrement())
  userId           String                  @map("user_id")
  gameIGDBId       Int                     @map("game_igdb_id")
  platformId       Int                     @map("platform_id")
  priorityId       Int?                    @map("priority_id")
  sortOrder        Int                     @map("sort_order")
  customCover      String?                 @map("custom_cover")
  customName       String?                 @map("custom_name")
  status           BacklogEntryStatus
  completionStatus BacklogCompletionStatus @map("completion_status")
  playtimeMinutes  Int?                    @map("playtime_minutes")
  completionTime   Int?                    @map("completion_time")
  startDate        DateTime?               @map("start_date")
  endDate          DateTime?               @map("end_date")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game     Game     @relation(fields: [gameIGDBId], references: [igdbId])
  platform Platform @relation(fields: [platformId], references: [igdbId])

  customTags CustomTag[]
  priority   Priority?           @relation(fields: [priorityId], references: [id])
  genres     BacklogEntryGenre[]

  @@unique([gameIGDBId, userId])
  @@map("backlog_entry")
}

model CustomTag {
  id      Int @id @default(autoincrement())
  entryId Int @map("entry_id")

  slot  TagSlot
  value String

  backlogEntry BacklogEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([slot, entryId])
  @@map("custom_tag")
}

model Review {
  id              Int    @default(autoincrement())
  gameId          Int
  displayUsername String

  score     Int?
  review    String?
  privacy   PrivacyStatus
  createdAt DateTime
  updatedAt DateTime

  game Game @relation(fields: [gameId], references: [igdbId])
  user User @relation(fields: [displayUsername], references: [displayUsername], onDelete: Cascade)

  @@unique([gameId, displayUsername])
}

// comments
// likes

model Comment {
  displayUsername String @unique
  listId          Int?
  reviewId        Int?
  commentId       Int?
}

model Like {
  displayUsername String @unique
  listId          Int?
  reviewId        Int?
  commentId       Int?
}

