enum PrivacyStatus {
  PUBLIC
  FRIENDS_ONLY
  PRIVATE
}

enum BacklogEntryStatus {
  BACKLOG
  PLAYING
  PLAYED
  WISHLIST
}

enum BacklogCompletionStatus {
  UNFINISHED
  BEATEN
  COMPLETED
  DROPPED
}

enum BacklogOwnership {
  OWNED
  NOT_OWNED
}

enum BacklogCardStatus {
  EARLY_ACCESS
  REGION_LOCKED
  BEATEN
  COMPLETED
  UNKNOWN
  DROPPED
  WISHLIST
  BACKLOG
  PLAYING
}
